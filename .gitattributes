* text=auto eol=lf

# Windows-only project files keep CRLF so Visual Studio stays happy.
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.ps1       text eol=crlf

# Binary assets
*.png  binary
*.ico  binary
*.icns binary
*.ttf  binary
*.woff2 binary
*.pdf  binary
