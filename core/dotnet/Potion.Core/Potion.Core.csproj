<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared processing logic for the Windows apps (Potion and Potion Dropper).
       Platform-neutral on purpose (plain net10.0) so it builds and tests on any OS.
       Windows-only engine wrappers live behind interfaces implemented in the apps or a
       separate net10.0-windows project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Potion.Core</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Shared spec, embedded straight from core/spec (no copy needed on .NET). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\spec\formats.json" LogicalName="Potion.Core.formats.json" Link="Spec\formats.json" />
    <EmbeddedResource Include="..\..\spec\matrix.json" LogicalName="Potion.Core.matrix.json" Link="Spec\matrix.json" />
    <EmbeddedResource Include="..\..\spec\presets.json" LogicalName="Potion.Core.presets.json" Link="Spec\presets.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Potion.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
