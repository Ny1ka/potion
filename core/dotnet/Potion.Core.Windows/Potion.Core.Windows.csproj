<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows-only engine code (WIC imaging, and later Windows.Data.Pdf) for the Windows apps. Builds on any OS
       (EnableWindowsTargeting) but runs only on Windows; its tests run in the Windows CI job. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Potion.Core.Windows</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Potion.Core\Potion.Core.csproj" />
  </ItemGroup>

</Project>
