      "expect": "accessDenied"
    },
    {
      "name": "forbidden",
      "status": 403,
      "headers": {},
      "expect": "accessDenied"
    },
    {
      "name": "proxy auth",
      "status": 407,
      "headers": {},
      "expect": "accessDenied"
    },
    {
      "name": "not found",
      "status": 404,
      "headers": {},
      "expect": "notFound"
    },
    {
      "name": "gone",
      "status": 410,
      "headers": {},
      "expect": "notFound"
    },
    {
      "name": "legal reasons",
      "status": 451,
      "headers": {},
      "expect": "unavailableForLegalReasons"
    },
    {
      "name": "too many requests, seconds",
      "status": 429,
      "headers": {
        "Retry-After": "10"
      },
      "expect": "retry",
      "seconds": 10
    },
    {
      "name": "too many requests, spaces",
      "status": 429,
      "headers": {
        "Retry-After": " 7 "
      },
      "expect": "retry",
      "seconds": 7
    },
    {
      "name": "too many requests, no header",
      "status": 429,
      "headers": {},
      "expect": "retry",
      "seconds": 5
    },
    {
      "name": "too many requests, bad header",
      "status": 429,
      "headers": {
        "Retry-After": "soon"
      },
      "expect": "retry",
      "seconds": 5
    },
    {
      "name": "too many requests, at the maximum",
      "status": 429,
      "headers": {
        "Retry-After": "60"
      },
      "expect": "retry",
      "seconds": 60
    },
    {
      "name": "too many requests, too long",
      "status": 429,
      "headers": {
        "Retry-After": "120"
      },
      "expect": "rateLimited"
    },
    {
      "name": "too many requests, date",
      "status": 429,
      "headers": {
        "Date": "Wed, 21 Oct 2026 07:27:30 GMT",
        "Retry-After": "Wed, 21 Oct 2026 07:28:00 GMT"
      },
      "expect": "retry",
      "seconds": 30
    },
    {
      "name": "too many requests, past date",
      "status": 429,
      "headers": {
        "Date": "Wed, 21 Oct 2026 07:27:30 GMT",
        "Retry-After": "Wed, 21 Oct 2026 07:20:00 GMT"
      },
      "expect": "retry",
      "seconds": 0
    },
    {
