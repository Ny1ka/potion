{
  "version": 1,
  "responses": [
    {
      "name": "mp4",
      "status": 200,
      "headers": {
        "Content-Type": "video/mp4",
        "Content-Length": "1000"
      },
      "expect": "media",
      "length": 1000
    },
    {
      "name": "type parameters and case",
      "status": 200,
      "headers": {
        "content-type": "Video/MP4; charset=binary"
      },
      "expect": "media"
    },
    {
      "name": "mp3",
      "status": 200,
      "headers": {
        "Content-Type": "audio/mpeg"
      },
      "expect": "media"
    },
    {
      "name": "ogg as application",
      "status": 200,
      "headers": {
        "Content-Type": "application/ogg"
      },
      "expect": "media"
    },
    {
      "name": "octet-stream is sniffed",
      "status": 200,
      "headers": {
        "Content-Type": "application/octet-stream",
        "Content-Length": "5"
      },
      "expect": "sniff",
      "length": 5
    },
    {
      "name": "no type is sniffed",
      "status": 200,
      "headers": {},
      "expect": "sniff"
    },
    {
      "name": "forced download is sniffed",
      "status": 200,
      "headers": {
        "Content-Type": "application/force-download"
      },
      "expect": "sniff"
    },
    {
      "name": "html page",
      "status": 200,
      "headers": {
        "Content-Type": "text/html; charset=utf-8"
      },
      "expect": "unsupportedSite"
    },
    {
      "name": "xhtml page",
      "status": 200,
      "headers": {
        "Content-Type": "application/xhtml+xml"
      },
      "expect": "unsupportedSite"
    },
    {
      "name": "image",
      "status": 200,
      "headers": {
        "Content-Type": "image/png"
      },
      "expect": "notMedia"
    },
    {
      "name": "pdf",
      "status": 200,
      "headers": {
        "Content-Type": "application/pdf"
      },
      "expect": "notMedia"
    },
    {
      "name": "json",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "expect": "notMedia"
    },
    {
      "name": "hls playlist",
