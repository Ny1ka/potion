      "headers": {
        "Content-Type": "application/vnd.apple.mpegurl"
      },
      "expect": "playlist"
    },
    {
      "name": "audio playlist type",
      "status": 200,
      "headers": {
        "Content-Type": "audio/x-mpegurl"
      },
      "expect": "playlist"
    },
    {
      "name": "dash manifest",
      "status": 200,
      "headers": {
        "Content-Type": "application/dash+xml"
      },
      "expect": "playlist"
    },
    {
      "name": "over the size limit",
      "status": 200,
      "headers": {
        "Content-Type": "video/mp4",
        "Content-Length": "2000"
      },
      "maxBytes": 1000,
      "expect": "tooLarge"
    },
    {
      "name": "at the size limit",
      "status": 200,
      "headers": {
        "Content-Type": "video/mp4",
        "Content-Length": "1000"
      },
      "maxBytes": 1000,
      "expect": "media",
      "length": 1000
    },
    {
      "name": "page over the limit is still a page",
      "status": 200,
      "headers": {
        "Content-Type": "text/html",
        "Content-Length": "2000"
      },
      "maxBytes": 1000,
      "expect": "unsupportedSite"
    },
    {
      "name": "bad length ignored",
      "status": 200,
      "headers": {
        "Content-Type": "video/mp4",
        "Content-Length": "abc"
      },
      "expect": "media"
    },
    {
      "name": "resumed",
      "status": 206,
      "range": true,
      "headers": {
        "Content-Type": "video/mp4",
        "Content-Length": "400",
        "Content-Range": "bytes 600-999/1000"
      },
      "expect": "media",
      "length": 400,
      "resumed": true
    },
    {
      "name": "resume ignored by server",
      "status": 200,
      "range": true,
      "headers": {
        "Content-Type": "video/mp4",
        "Content-Length": "1000"
      },
      "expect": "media",
      "length": 1000,
      "resumed": false
    },
    {
      "name": "partial without asking",
      "status": 206,
      "headers": {
        "Content-Type": "video/mp4"
      },
      "expect": "refused"
    },
    {
      "name": "range not satisfiable restarts",
      "status": 416,
      "range": true,
      "headers": {},
      "expect": "restart"
    },
    {
      "name": "range not satisfiable without range",
      "status": 416,
      "headers": {},
      "expect": "refused"
    },
    {
      "name": "moved",
      "status": 301,
      "headers": {
        "Location": "https://cdn.example.com/a.mp4"
      },
      "expect": "redirect",
      "location": "https://cdn.example.com/a.mp4"
    },
    {
      "name": "found, relative",
      "status": 302,
      "headers": {
        "location": "/files/a.mp4"
      },
      "expect": "redirect",
      "location": "/files/a.mp4"
    },
    {
      "name": "see other",
      "status": 303,
      "headers": {
        "Location": "https://example.com/b.mp3"
      },
      "expect": "redirect",
      "location": "https://example.com/b.mp3"
    },
    {
      "name": "temporary",
      "status": 307,
      "headers": {
        "Location": "b.mp3"
      },
      "expect": "redirect",
      "location": "b.mp3"
    },
    {
      "name": "permanent",
      "status": 308,
      "headers": {
        "Location": "https://example.org/c.wav"
      },
      "expect": "redirect",
      "location": "https://example.org/c.wav"
    },
    {
      "name": "redirect without location",
      "status": 302,
      "headers": {},
      "expect": "refused"
    },
    {
      "name": "unauthorized",
      "status": 401,
      "headers": {
