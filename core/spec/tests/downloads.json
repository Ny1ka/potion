  "robots": [
    {
      "name": "empty file",
      "robots": "",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "disallow everything",
      "robots": "User-agent: *\nDisallow: /",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": false
        },
        {
          "path": "/robots.txt",
          "allowed": true
        }
      ]
    },
    {
      "name": "allow inside disallow",
      "robots": "User-agent: *\nDisallow: /private/\nAllow: /private/public/",
      "paths": [
        {
          "path": "/private/x.mp4",
          "allowed": false
        },
        {
          "path": "/private/public/x.mp4",
          "allowed": true
        },
        {
          "path": "/other/x.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "our group overrides star",
      "robots": "User-agent: *\nDisallow: /\n\nUser-agent: PotionDropper\nAllow: /",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "our group, any case, only its rules",
      "robots": "User-agent: *\nDisallow: /\n\nUser-agent: potiondropper\nDisallow: /media",
      "paths": [
        {
          "path": "/media/a.mp4",
          "allowed": false
        },
        {
          "path": "/files/a.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "agent with version",
      "robots": "User-agent: PotionDropper/2.0\nDisallow: /x",
      "paths": [
        {
          "path": "/x/a.mp4",
          "allowed": false
        }
      ]
    },
    {
      "name": "other agents ignored",
      "robots": "User-agent: SomeBot\nDisallow: /",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "agent prefix isn't a match",
      "robots": "User-agent: Potion\nDisallow: /",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "grouped agents",
      "robots": "User-agent: SomeBot\nUser-agent: PotionDropper\nDisallow: /x",
      "paths": [
        {
          "path": "/x/1.mp4",
          "allowed": false
        }
      ]
    },
    {
      "name": "matching groups combine",
      "robots": "User-agent: PotionDropper\nDisallow: /a\n\nUser-agent: PotionDropper\nDisallow: /b",
      "paths": [
        {
          "path": "/a/1.mp4",
          "allowed": false
        },
        {
          "path": "/b/1.mp4",
          "allowed": false
        },
        {
          "path": "/c/1.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "rules before any agent ignored",
      "robots": "Disallow: /\nUser-agent: SomeBot\nDisallow: /",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "empty disallow",
      "robots": "User-agent: *\nDisallow:",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "comments, CRLF and key case",
      "robots": "USER-AGENT: * # everyone\r\nDISALLOW: /tmp # temporary\r\nSitemap: https://example.com/s.xml\r\n",
      "paths": [
        {
          "path": "/tmp/x.mp4",
          "allowed": false
        },
        {
          "path": "/x.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "wildcard and end anchor",
      "robots": "User-agent: *\nDisallow: /*.mp4$",
      "paths": [
        {
          "path": "/a.mp4",
          "allowed": false
        },
        {
          "path": "/dir/b.mp4",
          "allowed": false
        },
        {
          "path": "/a.mp4?x=1",
          "allowed": true
        },
        {
          "path": "/a.mp3",
          "allowed": true
        }
      ]
    },
    {
      "name": "longest match wins",
      "robots": "User-agent: *\nDisallow: /media\nAllow: /media/*.mp3",
      "paths": [
        {
          "path": "/media/a.mp3",
          "allowed": true
        },
        {
          "path": "/media/a.mp4",
          "allowed": false
        }
      ]
    },
    {
      "name": "tie goes to allow",
      "robots": "User-agent: *\nAllow: /a\nDisallow: /a",
      "paths": [
        {
          "path": "/a/b.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "query in pattern",
      "robots": "User-agent: *\nDisallow: /download?",
      "paths": [
        {
          "path": "/download?id=3",
          "allowed": false
        },
        {
          "path": "/download",
          "allowed": true
        }
      ]
    },
    {
      "name": "non-ascii pattern",
      "robots": "User-agent: *\nDisallow: /é",
      "paths": [
        {
          "path": "/%C3%A9t%C3%A9.mp4",
          "allowed": false
        },
        {
          "path": "/e.mp4",
          "allowed": true
        }
      ]
    },
    {
      "name": "case-sensitive paths",
      "robots": "User-agent: *\nDisallow: /Media",
      "paths": [
        {
          "path": "/media/a.mp4",
          "allowed": true
        },
        {
          "path": "/Media/a.mp4",
          "allowed": false
        }
      ]
    },
    {
