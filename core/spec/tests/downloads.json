  "fileNames": [
    {
      "name": "quoted filename",
      "disposition": "attachment; filename=\"clip.mp4\"",
      "link": "https://example.com/get?id=1",
      "expect": "clip.mp4"
    },
    {
      "name": "token filename",
      "disposition": "inline; filename=plain.wav",
      "link": "https://example.com/x",
      "expect": "plain.wav"
    },
    {
      "name": "extended filename wins",
      "disposition": "attachment; filename=\"resume.mp3\"; filename*=UTF-8''r%C3%A9sum%C3%A9.mp3",
      "link": "https://example.com/x",
      "expect": "résumé.mp3"
    },
    {
      "name": "latin-1 extended filename",
      "disposition": "attachment; filename*=iso-8859-1'en'caf%E9.mp3",
      "link": "https://example.com/x",
      "expect": "café.mp3"
    },
    {
      "name": "parameter names ignore case",
      "disposition": "Attachment; FileName=\"Upper.MP4\"",
      "link": "https://example.com/x",
      "expect": "Upper.MP4"
    },
    {
      "name": "semicolon inside quotes",
      "disposition": "attachment; filename=\"a; b.mp4\"; size=10",
      "link": "https://example.com/x",
      "expect": "a; b.mp4"
    },
    {
      "name": "escaped quote",
      "disposition": "attachment; filename=\"say \\\"hi\\\".mp3\"",
      "link": "https://example.com/x",
      "expect": "say _hi_.mp3"
    },
    {
      "name": "path removed",
      "disposition": "attachment; filename=\"../../etc/clip.mp4\"",
      "link": "https://example.com/x",
      "expect": "clip.mp4"
    },
    {
      "name": "windows path removed",
      "disposition": "attachment; filename=\"C:\\\\Users\\\\me\\\\clip.mp4\"",
      "link": "https://example.com/x",
      "expect": "clip.mp4"
    },
    {
      "name": "reserved characters replaced",
      "disposition": "attachment; filename=\"a<b>:c|d?*.mp4\"",
      "link": "https://example.com/x",
      "expect": "a_b__c_d__.mp4"
    },
    {
      "name": "control characters removed",
      "disposition": "attachment; filename=\"a\u0001b.mp4\"",
      "link": "https://example.com/x",
      "expect": "ab.mp4"
    },
    {
      "name": "dots and spaces trimmed",
      "disposition": "attachment; filename=\"  .hidden.mp4. \"",
      "link": "https://example.com/x",
      "expect": "hidden.mp4"
    },
    {
      "name": "reserved device name",
      "disposition": "attachment; filename=\"con.mp4\"",
      "link": "https://example.com/x",
      "expect": "_con.mp4"
    },
    {
      "name": "reserved device name with digit",
      "disposition": "attachment; filename=\"LPT1\"",
      "link": "https://example.com/x",
      "expect": "_LPT1"
    },
    {
      "name": "long name keeps extension",
      "disposition": "attachment; filename=\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.mp4\"",
      "link": "https://example.com/x",
      "expect": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.mp4"
    },
    {
      "name": "link file name",
      "disposition": null,
      "link": "https://example.com/media/My%20Clip.mp4?x=1",
      "expect": "My Clip.mp4"
    },
    {
      "name": "link file name sanitized",
      "disposition": null,
      "link": "https://example.com/a%3Ab%2Fc.mp4",
      "expect": "a_b_c.mp4"
    },
    {
      "name": "no file name uses host",
      "disposition": null,
      "link": "https://media.example.com/",
      "expect": "media.example.com"
    },
    {
      "name": "empty disposition name falls back",
      "disposition": "attachment; filename=\"...\"",
      "link": "https://example.com/a.mp3",
      "expect": "a.mp3"
    },
    {
      "name": "unparseable disposition falls back",
      "disposition": "attachment",
      "link": "https://example.com/b.mp3",
      "expect": "b.mp3"
    },
    {
      "name": "bad extended value falls back to filename",
      "disposition": "attachment; filename*=bogus; filename=\"ok.mp3\"",
      "link": "https://example.com/x",
      "expect": "ok.mp3"
    }
  ],
