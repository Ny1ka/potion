{
  "about": "Shared conformance cases for format detection. Both core/swift and core/dotnet run every case. 'bytes' is a list of segments concatenated in order: {hex}, {ascii} or {zeros: n}. 'expect.format' null means not supported.",
  "cases": [
    { "name": "PNG", "file": "a.png", "bytes": [{ "hex": "89504E470D0A1A0A0000000D49484452" }], "expect": { "format": "png", "method": "content" } },
    { "name": "PNG with uppercase extension", "file": "A.PNG", "bytes": [{ "hex": "89504E470D0A1A0A" }], "expect": { "format": "png", "method": "content", "mismatch": false } },
    { "name": "JPEG", "file": "a.jpeg", "bytes": [{ "hex": "FFD8FFE000104A464946" }], "expect": { "format": "jpg", "method": "content", "mismatch": false } },
    { "name": "GIF89a", "file": "a.gif", "bytes": [{ "ascii": "GIF89a" }, { "zeros": 8 }], "expect": { "format": "gif", "method": "content" } },
    { "name": "GIF87a", "file": "a.gif", "bytes": [{ "ascii": "GIF87a" }, { "zeros": 8 }], "expect": { "format": "gif", "method": "content" } },
    { "name": "WEBP", "file": "a.webp", "bytes": [{ "ascii": "RIFF" }, { "hex": "24000000" }, { "ascii": "WEBPVP8 " }], "expect": { "format": "webp", "method": "content" } },
    { "name": "WAV", "file": "a.wav", "bytes": [{ "ascii": "RIFF" }, { "hex": "24000000" }, { "ascii": "WAVEfmt " }], "expect": { "format": "wav", "method": "content" } },
    { "name": "AVI", "file": "a.avi", "bytes": [{ "ascii": "RIFF" }, { "hex": "24000000" }, { "ascii": "AVI LIST" }], "expect": { "format": "avi", "method": "content" } },
    { "name": "BMP", "file": "a.bmp", "bytes": [{ "ascii": "BM" }, { "hex": "36000000" }, { "zeros": 4 }, { "hex": "36000000" }], "expect": { "format": "bmp", "method": "content" } },
    { "name": "Text starting with BM is not BMP", "file": "notes.txt", "bytes": [{ "ascii": "BMW service history" }], "expect": { "format": "txt", "method": "extension" } },
    { "name": "ICO", "file": "a.ico", "bytes": [{ "hex": "0000010001001010" }], "expect": { "format": "ico", "method": "content" } },

    { "name": "TIFF little-endian", "file": "a.tif", "bytes": [{ "hex": "49492A0008000000" }], "expect": { "format": "tiff", "method": "content" } },
    { "name": "TIFF big-endian", "file": "a.tiff", "bytes": [{ "hex": "4D4D002A00000008" }], "expect": { "format": "tiff", "method": "content" } },
    { "name": "DNG is TIFF-structured, extension decides", "file": "a.dng", "bytes": [{ "hex": "49492A0008000000" }], "expect": { "format": "dng", "method": "content", "mismatch": false } },
    { "name": "NEF is TIFF-structured, extension decides", "file": "a.NEF", "bytes": [{ "hex": "4D4D002A00000008" }], "expect": { "format": "nef", "method": "content" } },
    { "name": "CR2", "file": "a.cr2", "bytes": [{ "hex": "49492A0010000000" }, { "ascii": "CR" }, { "hex": "0200" }], "expect": { "format": "cr2", "method": "content" } },
    { "name": "ORF", "file": "a.orf", "bytes": [{ "ascii": "IIRO" }, { "hex": "08000000" }], "expect": { "format": "orf", "method": "content" } },
    { "name": "RW2", "file": "a.rw2", "bytes": [{ "hex": "4949550018000000" }], "expect": { "format": "rw2", "method": "content" } },
    { "name": "RAF", "file": "a.raf", "bytes": [{ "ascii": "FUJIFILMCCD-RAW 0201" }], "expect": { "format": "raf", "method": "content" } },

    { "name": "HEIC", "file": "a.heic", "bytes": [{ "hex": "00000018" }, { "ascii": "ftypheic" }, { "zeros": 4 }, { "ascii": "mif1heic" }], "expect": { "format": "heic", "method": "content" } },
    { "name": "HEIF (mif1, no AVIF brand)", "file": "a.heif", "bytes": [{ "hex": "00000018" }, { "ascii": "ftypmif1" }, { "zeros": 4 }, { "ascii": "mif1heic" }], "expect": { "format": "heic", "method": "content", "mismatch": false } },
    { "name": "AVIF", "file": "a.avif", "bytes": [{ "hex": "00000020" }, { "ascii": "ftypavif" }, { "zeros": 4 }, { "ascii": "avifmif1miafMA1B" }], "expect": { "format": "avif", "method": "content" } },
    { "name": "AVIF with mif1 major brand", "file": "a.avif", "bytes": [{ "hex": "0000001C" }, { "ascii": "ftypmif1" }, { "zeros": 4 }, { "ascii": "mif1avifmiaf" }], "expect": { "format": "avif", "method": "content" } },
    { "name": "CR3", "file": "a.cr3", "bytes": [{ "hex": "00000018" }, { "ascii": "ftypcrx " }, { "zeros": 4 }, { "ascii": "crx isom" }], "expect": { "format": "cr3", "method": "content" } },
    { "name": "MP4 (isom)", "file": "a.mp4", "bytes": [{ "hex": "00000020" }, { "ascii": "ftypisom" }, { "hex": "00000200" }, { "ascii": "isomiso2avc1mp41" }], "expect": { "format": "mp4", "method": "content" } },
    { "name": "Generic ftyp named .mov keeps MOV", "file": "clip.mov", "bytes": [{ "hex": "00000020" }, { "ascii": "ftypisom" }, { "hex": "00000200" }, { "ascii": "isomiso2avc1mp41" }], "expect": { "format": "mov", "method": "content" } },
    { "name": "M4A", "file": "a.m4a", "bytes": [{ "hex": "0000001C" }, { "ascii": "ftypM4A " }, { "zeros": 4 }, { "ascii": "M4A mp42isom" }, { "zeros": 16 }, { "ascii": "moov" }, { "zeros": 8 }, { "ascii": "mp4a" }], "expect": { "format": "m4a", "method": "content" } },
    { "name": "ALAC inside M4A", "file": "a.m4a", "bytes": [{ "hex": "0000001C" }, { "ascii": "ftypM4A " }, { "zeros": 4 }, { "ascii": "M4A mp42isom" }, { "zeros": 16 }, { "ascii": "moov" }, { "zeros": 8 }, { "ascii": "alac" }], "expect": { "format": "alac", "method": "content", "mismatch": false } },
    { "name": "M4V", "file": "a.m4v", "bytes": [{ "hex": "00000018" }, { "ascii": "ftypM4V " }, { "zeros": 4 }, { "ascii": "M4V mp42" }], "expect": { "format": "m4v", "method": "content" } },
    { "name": "MOV (qt brand)", "file": "a.mov", "bytes": [{ "hex": "00000014" }, { "ascii": "ftypqt  " }, { "zeros": 4 }, { "ascii": "qt  " }], "expect": { "format": "mov", "method": "content" } },
    { "name": "MOV without ftyp", "file": "old.mov", "bytes": [{ "hex": "00000008" }, { "ascii": "wide" }, { "hex": "00001000" }, { "ascii": "mdat" }], "expect": { "format": "mov", "method": "content" } },
    { "name": "3GP", "file": "a.3gp", "bytes": [{ "hex": "00000018" }, { "ascii": "ftyp3gp4" }, { "zeros": 4 }, { "ascii": "isom3gp4" }], "expect": { "format": "3gp", "method": "content" } },

    { "name": "MKV", "file": "a.mkv", "bytes": [{ "hex": "1A45DFA3A34286810142F7810142F2810442F381084282" }, { "hex": "88" }, { "ascii": "matroska" }], "expect": { "format": "mkv", "method": "content" } },
    { "name": "WEBM", "file": "a.webm", "bytes": [{ "hex": "1A45DFA39F4286810142F7810142F2810442F381084282" }, { "hex": "84" }, { "ascii": "webm" }], "expect": { "format": "webm", "method": "content" } },
    { "name": "WMV (ASF with a video stream)", "file": "a.wmv", "bytes": [{ "hex": "3026B2758E66CF11A6D900AA0062CE6C" }, { "zeros": 64 }, { "hex": "C0EF19BC4D5BCF11A8FD00805F5C442B" }], "expect": { "format": "wmv", "method": "content" } },
    { "name": "WMA (ASF, audio only)", "file": "a.wma", "bytes": [{ "hex": "3026B2758E66CF11A6D900AA0062CE6C" }, { "zeros": 64 }, { "hex": "409E69F84D5BCF11A8FD00805F5C442B" }], "expect": { "format": "wma", "method": "content" } },
    { "name": "ASF named .wmv without a visible video stream", "file": "a.wmv", "bytes": [{ "hex": "3026B2758E66CF11A6D900AA0062CE6C" }, { "zeros": 64 }], "expect": { "format": "wmv", "method": "content" } },
    { "name": "FLV", "file": "a.flv", "bytes": [{ "hex": "464C5601050000000900000000" }], "expect": { "format": "flv", "method": "content" } },
    { "name": "MPEG program stream", "file": "a.mpg", "bytes": [{ "hex": "000001BA4400040004010189C3F8" }], "expect": { "format": "mpeg", "method": "content", "mismatch": false } },
    { "name": "MPEG transport stream", "file": "a.ts", "bytes": [{ "hex": "47" }, { "zeros": 187 }, { "hex": "47" }, { "zeros": 187 }, { "hex": "47" }, { "zeros": 20 }], "expect": { "format": "ts", "method": "content" } },
    { "name": "M2TS (192-byte packets)", "file": "a.m2ts", "bytes": [{ "zeros": 4 }, { "hex": "47" }, { "zeros": 191 }, { "hex": "47" }, { "zeros": 191 }, { "hex": "47" }, { "zeros": 10 }], "expect": { "format": "ts", "method": "content", "mismatch": false } },
    { "name": "TypeScript source is not a video", "file": "app.ts", "bytes": [{ "ascii": "export const answer: number = 42;\n" }], "expect": { "format": null, "method": "none" } },

    { "name": "FLAC", "file": "a.flac", "bytes": [{ "ascii": "fLaC" }, { "hex": "00000022" }], "expect": { "format": "flac", "method": "content" } },
    { "name": "OGG Vorbis", "file": "a.ogg", "bytes": [{ "ascii": "OggS" }, { "zeros": 24 }, { "hex": "01" }, { "ascii": "vorbis" }], "expect": { "format": "ogg", "method": "content" } },
    { "name": "OPUS", "file": "a.opus", "bytes": [{ "ascii": "OggS" }, { "zeros": 24 }, { "ascii": "OpusHead" }], "expect": { "format": "opus", "method": "content" } },
    { "name": "Opus stream named .ogg", "file": "a.ogg", "bytes": [{ "ascii": "OggS" }, { "zeros": 24 }, { "ascii": "OpusHead" }], "expect": { "format": "opus", "method": "content", "mismatch": true } },
    { "name": "AIFF", "file": "a.aif", "bytes": [{ "ascii": "FORM" }, { "hex": "00001000" }, { "ascii": "AIFFCOMM" }], "expect": { "format": "aiff", "method": "content" } },
    { "name": "AIFF-C", "file": "a.aifc", "bytes": [{ "ascii": "FORM" }, { "hex": "00001000" }, { "ascii": "AIFCFVER" }], "expect": { "format": "aiff", "method": "content" } },
    { "name": "MP3 with ID3 tag", "file": "a.mp3", "bytes": [{ "ascii": "ID3" }, { "hex": "04000000000A" }], "expect": { "format": "mp3", "method": "content" } },
    { "name": "ID3 tag on a .flac keeps FLAC", "file": "a.flac", "bytes": [{ "ascii": "ID3" }, { "hex": "04000000000A" }], "expect": { "format": "flac", "method": "content" } },
    { "name": "MP3 frame sync", "file": "a.mp3", "bytes": [{ "hex": "FFFB904400000000" }], "expect": { "format": "mp3", "method": "content" } },
    { "name": "AAC ADTS", "file": "a.aac", "bytes": [{ "hex": "FFF15080" }, { "zeros": 4 }], "expect": { "format": "aac", "method": "content" } },
    { "name": "MP3 bytes in an unknown container", "file": "track", "bytes": [{ "hex": "FFF3904400000000" }], "expect": { "format": "mp3", "method": "content" } },

    { "name": "PDF", "file": "a.pdf", "bytes": [{ "ascii": "%PDF-1.7\n" }, { "hex": "25E2E3CFD3" }], "expect": { "format": "pdf", "method": "content" } },
    { "name": "PDF with leading junk", "file": "a.pdf", "bytes": [{ "zeros": 100 }, { "ascii": "%PDF-1.4\n" }], "expect": { "format": "pdf", "method": "content" } },
    { "name": "DOC (OLE with WordDocument stream)", "file": "a.doc", "bytes": [{ "hex": "D0CF11E0A1B11AE1" }, { "zeros": 1016 }, { "hex": "57006F007200640044006F00630075006D0065006E007400" }], "expect": { "format": "doc", "method": "content" } },
    { "name": "DOC by OLE header and extension", "file": "a.doc", "bytes": [{ "hex": "D0CF11E0A1B11AE1" }, { "zeros": 32 }], "expect": { "format": "doc", "method": "content" } },
    { "name": "Excel 97 file is not supported", "file": "a.xls", "bytes": [{ "hex": "D0CF11E0A1B11AE1" }, { "zeros": 32 }], "expect": { "format": null, "method": "none" } },
    { "name": "EPUB", "file": "a.epub", "bytes": [{ "hex": "504B0304" }, { "zeros": 26 }, { "ascii": "mimetypeapplication/epub+zip" }], "expect": { "format": "epub", "method": "content" } },
    { "name": "ODT", "file": "a.odt", "bytes": [{ "hex": "504B0304" }, { "zeros": 26 }, { "ascii": "mimetypeapplication/vnd.oasis.opendocument.text" }], "expect": { "format": "odt", "method": "content" } },
    { "name": "DOCX", "file": "a.docx", "bytes": [{ "hex": "504B0304" }, { "zeros": 26 }, { "ascii": "[Content_Types].xml" }, { "zeros": 40 }, { "hex": "504B0304" }, { "zeros": 26 }, { "ascii": "word/document.xml" }], "expect": { "format": "docx", "method": "content" } },
    { "name": "XLSX is not supported", "file": "a.xlsx", "bytes": [{ "hex": "504B0304" }, { "zeros": 26 }, { "ascii": "[Content_Types].xml" }, { "zeros": 40 }, { "hex": "504B0304" }, { "zeros": 26 }, { "ascii": "xl/workbook.xml" }], "expect": { "format": null, "method": "none" } },
    { "name": "Plain ZIP is not supported", "file": "a.zip", "bytes": [{ "hex": "504B0304" }, { "zeros": 26 }, { "ascii": "photos/1.jpg" }], "expect": { "format": null, "method": "none" } },

    { "name": "RTF", "file": "a.rtf", "bytes": [{ "ascii": "{\\rtf1\\ansi\\deff0 Hello}" }], "expect": { "format": "rtf", "method": "extension" } },
    { "name": "RTF without an extension", "file": "letter", "bytes": [{ "ascii": "{\\rtf1\\ansi Hello}" }], "expect": { "format": "rtf", "method": "content" } },
    { "name": "TXT", "file": "a.txt", "bytes": [{ "ascii": "Hello, world.\n" }], "expect": { "format": "txt", "method": "extension" } },
    { "name": "UTF-16 text with BOM", "file": "a.txt", "bytes": [{ "hex": "FFFE480065006C006C006F00" }], "expect": { "format": "txt", "method": "extension" } },
    { "name": "Markdown", "file": "README.md", "bytes": [{ "ascii": "# Title\n\nSome *text*.\n" }], "expect": { "format": "md", "method": "extension" } },
    { "name": "Markdown long extension", "file": "notes.markdown", "bytes": [{ "ascii": "- item\n" }], "expect": { "format": "md", "method": "extension", "mismatch": false } },
    { "name": "Markdown with inline SVG stays Markdown", "file": "doc.md", "bytes": [{ "ascii": "# Icon\n<svg width=\"10\"></svg>\n" }], "expect": { "format": "md", "method": "extension" } },
    { "name": "HTML", "file": "page.html", "bytes": [{ "ascii": "<!DOCTYPE html><html><body>Hi</body></html>" }], "expect": { "format": "html", "method": "extension" } },
    { "name": "HTML without an extension", "file": "page", "bytes": [{ "ascii": "\n  <!DOCTYPE HTML>\n<html lang=\"en\">" }], "expect": { "format": "html", "method": "content" } },
    { "name": "SVG", "file": "icon.svg", "bytes": [{ "ascii": "<?xml version=\"1.0\"?>\n<svg xmlns=\"http://www.w3.org/2000/svg\"/>" }], "expect": { "format": "svg", "method": "extension" } },
    { "name": "SVG without an extension", "file": "icon", "bytes": [{ "ascii": "<?xml version=\"1.0\"?>\n<svg xmlns=\"http://www.w3.org/2000/svg\"/>" }], "expect": { "format": "svg", "method": "content" } },

    { "name": "PNG renamed to .txt is still PNG", "file": "photo.txt", "bytes": [{ "hex": "89504E470D0A1A0A" }], "expect": { "format": "png", "method": "content", "mismatch": true } },
    { "name": "JPEG renamed to .png", "file": "photo.png", "bytes": [{ "hex": "FFD8FFE1" }], "expect": { "format": "jpg", "method": "content", "mismatch": true } },
    { "name": "Unrecognized binary with a known extension falls back to it", "file": "song.mp3", "bytes": [{ "hex": "0102030405060708" }], "expect": { "format": "mp3", "method": "extension" } },
    { "name": "Text file with a binary extension is not that format", "file": "song.mp3", "bytes": [{ "ascii": "this is not audio" }], "expect": { "format": null, "method": "none" } },
    { "name": "Unknown binary, unknown extension", "file": "data.bin", "bytes": [{ "hex": "0102030405060708" }], "expect": { "format": null, "method": "none" } },
    { "name": "Unknown text, unknown extension", "file": "main.swift", "bytes": [{ "ascii": "import Foundation\n" }], "expect": { "format": null, "method": "none" } },
    { "name": "Empty file", "file": "empty.png", "bytes": [], "expect": { "format": null, "method": "none" } },
    { "name": "Dotfile has no extension", "file": ".png", "bytes": [{ "ascii": "hello" }], "expect": { "format": null, "method": "none" } }
  ]
}
