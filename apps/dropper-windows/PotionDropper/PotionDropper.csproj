<Project Sdk="Microsoft.NET.Sdk">

  <!-- Potion Dropper for Windows: WinUI 3 / Windows App SDK, unpackaged (MSIX in M9). Builds on Windows only. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PotionDropper</RootNamespace>
    <AssemblyName>PotionDropper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\..\design-system\windows\PotionDropper\Assets\PotionDropper.ico</ApplicationIcon>
    <Product>Potion Dropper</Product>
    <Version>0.9.0</Version>
    <Copyright>Copyright © 2026 Nyika. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <!-- Only the platform-neutral core: Dropper converts audio and video with FFmpeg (no WIC or PDF engines). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\core\dotnet\Potion.Core\Potion.Core.csproj" />
  </ItemGroup>

  <!-- The LGPL FFmpeg build ships as separate programs in an "ffmpeg" folder next to PotionDropper.exe, where
       FFmpegTools.Locate looks. Debug builds without it still run; Release builds require it. -->
  <ItemGroup Condition="Exists('..\..\..\build\ffmpeg\windows\bin\ffmpeg.exe')">
    <Content Include="..\..\..\build\ffmpeg\windows\bin\ffmpeg.exe;..\..\..\build\ffmpeg\windows\bin\ffprobe.exe"
             Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireFFmpeg" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Release' And !Exists('..\..\..\build\ffmpeg\windows\bin\ffmpeg.exe')">
    <Error Text="FFmpeg build missing at build\ffmpeg\windows\bin. Run scripts/ffmpeg/build-windows.sh" />
  </Target>

  <!-- Shared About window and legal documents; the documents ship in a Legal folder next to the app. -->
  <ItemGroup>
    <Compile Include="..\..\shared\windows\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Content Include="..\..\..\legal\TERMS.md;..\..\..\legal\PRIVACY.md;..\..\..\legal\THIRD_PARTY_NOTICES.md;..\..\..\LICENSE"
             Link="Legal\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Generated by the design system; referenced in place, never copied or edited. -->
  <ItemGroup>
    <Compile Include="..\..\..\design-system\windows\Shared\PotionDesign.cs" Link="Shared\PotionDesign.cs" />
    <Page Include="..\..\..\design-system\windows\Shared\PotionTheme.xaml" Link="Shared\PotionTheme.xaml" />
    <Content Include="..\..\..\design-system\windows\PotionDropper\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
