<Window
    x:Class="PotionDropper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Potion Dropper">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- title bar -->
            <RowDefinition Height="Auto" />   <!-- link bar -->
            <RowDefinition Height="Auto" />   <!-- link check -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (09-platforms.md): small mark + app name. -->
        <Grid x:Name="AppTitleBar" Height="48" Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{StaticResource PotionSpace3}" Margin="16,0,0,0">
                <Image Source="ms-appx:///Assets/Square44x44Logo.targetsize-16.png" Width="16" Height="16"
                       AutomationProperties.AccessibilityView="Raw" />
                <TextBlock Text="Potion Dropper" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Link bar (05-layout.md, "Potion Dropper: main window"). -->
        <Grid Grid.Row="1" Margin="24,8,24,0" ColumnSpacing="{StaticResource PotionSpace2}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LinkBox" PlaceholderText="Paste a video link" KeyDown="LinkBox_KeyDown"
                     TextChanged="LinkBox_TextChanged" AutomationProperties.Name="Link" />
            <Button Grid.Column="1" Content="Paste" Click="Paste_Click" />
            <Button x:Name="FetchButton" Grid.Column="2" Content="Fetch" Style="{StaticResource AccentButtonStyle}"
                    Click="Fetch_Click" IsEnabled="False" />
        </Grid>

        <StackPanel x:Name="CheckPanel" Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource PotionSpace2}"
                    Margin="24,12,24,0" Visibility="Collapsed">
            <FontIcon x:Name="CheckIcon" FontSize="14" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="CheckText" TextWrapping="Wrap" Style="{StaticResource BodyTextBlockStyle}" />
        </StackPanel>
    </Grid>
</Window>
