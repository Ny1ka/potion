<Project Sdk="Microsoft.NET.Sdk">

  <!-- Potion for Windows: WinUI 3 / Windows App SDK. Builds on Windows only.
       M0 is unpackaged; MSIX packaging (needed for the File Explorer context menu) arrives in M4. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Potion</RootNamespace>
    <AssemblyName>Potion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\..\design-system\windows\Potion\Assets\Potion.ico</ApplicationIcon>
    <Product>Potion</Product>
    <Version>0.1.0</Version>
    <Copyright>Copyright © 2026 Nyika. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\dotnet\Potion.Core\Potion.Core.csproj" />
  </ItemGroup>

  <!-- Generated by the design system; referenced in place, never copied or edited. -->
  <ItemGroup>
    <Compile Include="..\..\..\design-system\windows\Shared\PotionDesign.cs" Link="Shared\PotionDesign.cs" />
    <Page Include="..\..\..\design-system\windows\Shared\PotionTheme.xaml" Link="Shared\PotionTheme.xaml" />
    <Content Include="..\..\..\design-system\windows\Potion\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
