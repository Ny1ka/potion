<Project Sdk="Microsoft.NET.Sdk">

  <!-- Potion for Windows: WinUI 3 / Windows App SDK. Builds on Windows only.
       M0 is unpackaged; MSIX packaging (needed for the File Explorer context menu) arrives in M4. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Potion</RootNamespace>
    <AssemblyName>Potion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\..\design-system\windows\Potion\Assets\Potion.ico</ApplicationIcon>
    <Product>Potion</Product>
    <Version>0.9.0</Version>
    <!-- Program.cs provides Main (single instance); the XAML compiler must not generate one. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Copyright>Copyright © 2026 Nyika. MIT License.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core\dotnet\Potion.Core\Potion.Core.csproj" />
    <ProjectReference Include="..\..\..\core\dotnet\Potion.Core.Windows\Potion.Core.Windows.csproj" />
  </ItemGroup>

  <!-- The LGPL FFmpeg build (scripts/ffmpeg/build-windows.sh) ships as separate programs in an "ffmpeg" folder next to
       Potion.exe, where FFmpegTools.Locate looks. Debug builds without it still run (audio/video report the tools as
       missing); Release builds require it. -->
  <ItemGroup Condition="Exists('..\..\..\build\ffmpeg\windows\bin\ffmpeg.exe')">
    <Content Include="..\..\..\build\ffmpeg\windows\bin\ffmpeg.exe;..\..\..\build\ffmpeg\windows\bin\ffprobe.exe"
             Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireFFmpeg" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Release' And !Exists('..\..\..\build\ffmpeg\windows\bin\ffmpeg.exe')">
    <Error Text="FFmpeg build missing at build\ffmpeg\windows\bin. Run scripts/ffmpeg/build-windows.sh" />
  </Target>

  <!-- Shared About window and legal documents; the documents ship in a Legal folder next to the app. -->
  <ItemGroup>
    <Compile Include="..\..\shared\windows\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <Content Include="..\..\..\legal\TERMS.md;..\..\..\legal\PRIVACY.md;..\..\..\legal\THIRD_PARTY_NOTICES.md;..\..\..\LICENSE"
             Link="Legal\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Generated by the design system; referenced in place, never copied or edited. -->
  <ItemGroup>
    <Compile Include="..\..\..\design-system\windows\Shared\PotionDesign.cs" Link="Shared\PotionDesign.cs" />
    <Page Include="..\..\..\design-system\windows\Shared\PotionTheme.xaml" Link="Shared\PotionTheme.xaml" />
    <Content Include="..\..\..\design-system\windows\Potion\Assets\**\*" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
