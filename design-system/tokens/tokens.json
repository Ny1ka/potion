{
  "meta": {
    "system": "Potion Design System",
    "version": "1.0.0",
    "updated": "2026-11-21",
    "products": ["Potion (file converter)", "Potion Dropper (media downloader + converter)"],
    "platforms": ["macOS", "Windows"],
    "note": "Source of truth. Edit this file, then run `python3 tools/build.py` to regenerate CSS, Swift, XAML, asset catalogs, logos and icon exports. Colors are sRGB hex."
  },

  "brand": {
    "category": {
      "image": { "label": "Image", "fill": "#2DD4BF", "textOnDark": "#2DD4BF", "textOnLight": "#197C70", "onFill": "#17141F", "order": 1 },
      "audio": { "label": "Audio", "fill": "#FF9F43", "textOnDark": "#FF9F43", "textOnLight": "#B15600", "onFill": "#17141F", "order": 2 },
      "video": { "label": "Video", "fill": "#FF4F7B", "textOnDark": "#FF4F7B", "textOnLight": "#E00038", "onFill": "#17141F", "order": 3 },
      "docs":  { "label": "Docs",  "fill": "#7C6CFF", "textOnDark": "#7C6CFF", "textOnLight": "#6553FF", "onFill": "#17141F", "order": 4 }
    },
    "categoryTintAlpha": { "dark": 0.18, "light": 0.14 },
    "ink": "#17141F",
    "paper": "#FFFFFF",
    "neck": { "onDark": "#FFFFFF", "onLight": "#17141F", "neutral": "#8F88A2" },
    "iconTile": { "fill": "#17141F", "stroke": "#FFFFFF", "strokeAlpha": 0.08 },
    "marketingBackground": "#0E0C14"
  },

  "color": {
    "dark": {
      "background":     "#0E0C14",
      "surface":        "#17141F",
      "surfaceRaised":  "#211D2B",
      "surfaceSunken":  "#0B0A10",
      "border":         "#2E2939",
      "borderStrong":   "#8A849C",
      "textPrimary":    "#FFFFFF",
      "textSecondary":  "#B6B0C4",
      "textTertiary":   "#9A94A8",
      "textDisabled":   "#5E5869",
      "success":        "#3DD68C",
      "warning":        "#FFC53D",
      "error":          "#FF6B6B",
      "scrim":          "#000000B3"
    },
    "light": {
      "background":     "#F7F6FA",
      "surface":        "#FFFFFF",
      "surfaceRaised":  "#EFEDF3",
      "surfaceSunken":  "#ECEAF1",
      "border":         "#E4E1EA",
      "borderStrong":   "#C9C4D3",
      "textPrimary":    "#17141F",
      "textSecondary":  "#4D475A",
      "textTertiary":   "#6B6577",
      "textDisabled":   "#A8A3B3",
      "success":        "#12804A",
      "warning":        "#8F5F00",
      "error":          "#C62A2F",
      "scrim":          "#17141F66"
    },
    "accent": {
      "rule": "Interactive accent (primary buttons, selection, focus ring, overall progress, links) is the OPERATING SYSTEM accent color: NSColor.controlAccentColor on macOS, SystemAccentColor on Windows. Never hard-code a brand accent and never use a category color as an accent.",
      "fallback": { "dark": "#FFFFFF", "light": "#17141F" }
    }
  },

  "typography": {
    "brand": {
      "family": "Space Grotesk",
      "files": ["fonts/SpaceGrotesk-Medium.ttf", "fonts/SpaceGrotesk-Bold.ttf"],
      "postscriptNames": { "500": "SpaceGrotesk-Medium", "700": "SpaceGrotesk-Bold" },
      "usage": "Wordmark (already outlined in logos/), onboarding hero, About window title, marketing. Never for UI controls or body text."
    },
    "ui": {
      "macos":   { "family": "System (SF Pro)", "mono": "System monospaced (SF Mono)" },
      "windows": { "family": "Segoe UI Variable", "mono": "Cascadia Mono, Consolas" }
    },
    "roles": {
      "brandDisplay":  { "family": "brand", "weight": 700, "size": { "macos": 40, "windows": 40 }, "lineHeight": 1.05, "tracking": "-0.03em", "macosStyle": null, "windowsStyle": null },
      "title":         { "family": "ui", "weight": 600, "size": { "macos": 17, "windows": 20 }, "macosStyle": ".title3 (semibold)", "windowsStyle": "SubtitleTextBlockStyle" },
      "sectionHeader": { "family": "ui", "weight": 600, "size": { "macos": 13, "windows": 14 }, "macosStyle": ".headline", "windowsStyle": "BodyStrongTextBlockStyle" },
      "body":          { "family": "ui", "weight": 400, "size": { "macos": 13, "windows": 14 }, "macosStyle": ".body", "windowsStyle": "BodyTextBlockStyle" },
      "secondary":     { "family": "ui", "weight": 400, "size": { "macos": 11, "windows": 12 }, "color": "textSecondary", "macosStyle": ".subheadline", "windowsStyle": "CaptionTextBlockStyle" },
      "caption":       { "family": "ui", "weight": 400, "size": { "macos": 10, "windows": 12 }, "color": "textTertiary", "macosStyle": ".caption", "windowsStyle": "CaptionTextBlockStyle" },
      "formatBadge":   { "family": "mono", "weight": 600, "size": { "macos": 10, "windows": 11 }, "transform": "uppercase", "tracking": "0.04em" },
      "fileName":      { "family": "ui", "weight": 500, "size": { "macos": 13, "windows": 14 }, "truncation": "middle" }
    }
  },

  "spacing": { "0": 0, "0.5": 2, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },

  "radius": {
    "xs": 4,
    "sm": { "macos": 6, "windows": 4 },
    "md": 8,
    "lg": 12,
    "xl": 16,
    "full": 999,
    "iconTileRatio": 0.225,
    "note": "sm = standard control radius per platform (macOS controls ~6, WinUI ControlCornerRadius 4). md = category tiles, cards. lg = drop zone, sheets, popovers (WinUI OverlayCornerRadius is 8; use 8 there)."
  },

  "size": {
    "categoryTile": { "sm": 20, "md": 28, "lg": 40, "xl": 64 },
    "categoryGlyph": { "sm": 12, "md": 16, "lg": 22, "xl": 34 },
    "queueRowHeight": { "compact": 44, "regular": 56 },
    "progressBarHeight": { "macos": 4, "windows": 4 },
    "dropZoneMinHeight": 220,
    "convertSheetWidth": 460,
    "hitTargetMin": { "macos": 28, "windows": 32 },
    "window": {
      "macos":   { "default": [720, 520], "min": [560, 420] },
      "windows": { "default": [820, 580], "min": [600, 440] }
    },
    "logoMinimum": { "markPx": 16, "lockupWidthPx": 96 }
  },

  "motion": {
    "duration": { "instant": 0, "fast": 120, "base": 200, "slow": 320, "splashOnce": 1300 },
    "easing": {
      "standard":   [0.2, 0.8, 0.2, 1.0],
      "emphasized": [0.3, 1.3, 0.5, 1.0],
      "exit":       [0.4, 0.0, 1.0, 1.0]
    },
    "reduceMotion": "When the OS reduce-motion setting is on, replace every movement with an opacity fade of `fast` duration or show the end state immediately."
  },

  "elevation": {
    "dark":  { "popover": "0 8 24 0 #00000059", "sheet": "0 16 48 0 #00000073" },
    "light": { "popover": "0 8 24 0 #17141F1F", "sheet": "0 16 48 0 #17141F2E" },
    "note": "Prefer platform materials and system shadows (NSVisualEffectView / Mica, WinUI ThemeShadow). These values are for custom-drawn views only."
  }
}
